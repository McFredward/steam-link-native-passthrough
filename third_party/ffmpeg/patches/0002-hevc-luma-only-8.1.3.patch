--- a/libavcodec/hevc/hevcdec.h
+++ b/libavcodec/hevc/hevcdec.h
@@ -596,6 +596,17 @@
     AVBufferRef *rpu_buf;       ///< 0 or 1 Dolby Vision RPUs.
     DOVIContext dovi_ctx;       ///< Dolby Vision decoding context
 } HEVCContext;
+
+/* The private mask consumer publishes only Y. Preserve all syntax/entropy and
+ * luma reconstruction/filtering; other profiles retain complete reconstruction.
+ * Chroma samples are deliberately unspecified only for this explicit mode. */
+static av_always_inline int ff_hevc_skip_chroma(const HEVCContext *s, const HEVCSPS *sps)
+{
+    return (s->avctx->flags & AV_CODEC_FLAG_GRAY) &&
+           sps->ptl.general_ptl.profile_idc == AV_PROFILE_HEVC_MAIN &&
+           sps->chroma_format_idc == 1 && sps->bit_depth == 8 &&
+           sps->bit_depth_chroma == 8;
+}
 
